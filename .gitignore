# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Localisation output. `flutter gen-l10n` regenerates this from the ARB files in
# lib/l10n/arb on every build, and it is deterministic, so committing it would
# only create a second copy to keep in sync by hand. The ARB files are the source
# of truth. The directory still exists for the analyzer and the compiler, which is
# why this is an ignore rather than a delete.
lib/l10n/gen/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local build configuration. Optional since D6, which compiles the development
# credentials into debug builds so a bare `flutter run` works. Useful for pointing
# a build at a different Supabase project. The publishable key is public by
# design, but a database password must never reach version control, so this file
# is kept out entirely and each developer supplies their own.
#
# Named to avoid colliding with `.env.local`, which the Supabase CLI reads as
# dotenv while `--dart-define-from-file` requires JSON.
tool/*.local.json

# Supabase CLI local state
supabase/.temp/
